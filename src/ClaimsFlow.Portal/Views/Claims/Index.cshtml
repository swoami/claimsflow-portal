@model IReadOnlyList<ClaimRow>
@{
    ViewData["Title"] = "Claims";
    var partnerId = (string)ViewBag.PartnerId;
    var partners = (List<string>)ViewBag.Partners;
}

<h2>Claims for @partnerId</h2>

<p>
    Partner:
    @foreach (var p in partners)
    {
        <a asp-action="Index" asp-route-partnerId="@p">@p</a> <span>&nbsp;</span>
    }
</p>

@if (Model.Count == 0)
{
    <p>No claims yet for this partner.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Claim</th><th>Policy</th><th>Amount</th><th>Risk</th>
                <th>Status</th><th>Decision</th><th>Submitted</th><th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var claim in Model)
        {
            <tr>
                <td><a asp-action="Detail" asp-route-partnerId="@claim.PartitionKey" asp-route-id="@claim.RowKey">@claim.RowKey</a></td>
                <td>@claim.PolicyNumber</td>
                <td>@claim.AmountClaimed.ToString("N2") @claim.Currency</td>
                <td class="@(claim.RiskScore >= 80 ? "risk-high" : null)">@claim.RiskScore</td>
                <td>@claim.Status</td>
                <td>@(claim.Decision ?? "-")</td>
                <td>@claim.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="actions">
                    @if (claim.Status == ClaimStatuses.AwaitingReview && claim.Decision == null)
                    {
                        <form asp-action="Decide" method="post">
                            <input type="hidden" name="partnerId" value="@claim.PartitionKey" />
                            <input type="hidden" name="id" value="@claim.RowKey" />
                            <button type="submit" name="decision" value="@ClaimStatuses.Approved">Approve</button>
                            <button type="submit" name="decision" value="@ClaimStatuses.Rejected">Reject</button>
                        </form>
                    }
                    <a asp-action="Document" asp-route-partnerId="@claim.PartitionKey" asp-route-id="@claim.RowKey">document</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
