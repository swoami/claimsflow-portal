<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClaimsFlow Portal</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <h1>ClaimsFlow <span class="sub">operator console</span></h1>
        <p class="stack">ASP.NET Core 6.0 &middot; out of support since 12 Nov 2024</p>
    </header>
    <main>
        @if (TempData["Message"] != null)
        {
            <p class="notice">@TempData["Message"]</p>
        }
        @RenderBody()
    </main>
</body>
</html>
