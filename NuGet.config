<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pinned to nuget.org so the build is reproducible on any machine and does
       not depend on locally registered Visual Studio offline package folders. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
